# Логин и пароль для входа в админку (пароль обязателен, логин по умолчанию admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# PostgreSQL (Supabase → Connect → Direct connection). В Railway включите Outbound IPv6.
# Настоящий пароль задавайте только в Railway Variables или локальном .env, не коммитьте его.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Внешний HTTPS-адрес сервиса без слэша в конце. Нужен для вебхуков GREEN-API и ссылок на медиа
PUBLIC_URL=https://wa.example.com

# Секрет в адресе вебхука: PUBLIC_URL/webhook/<WEBHOOK_SECRET>. Сгенерировать: openssl rand -hex 24
WEBHOOK_SECRET=

# Секрет подписи cookie. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Часовой пояс для дневных лимитов и окна отправки
TZ_NAME=Asia/Almaty

PORT=3000

# Нижняя граница паузы между сообщениями одного номера, сек
MIN_DELAY_SEC=5

# Партнёрский токен GREEN-API. Если задан, кнопка «Подключить номер» сама создаёт подключение,
# и клиенту остаётся только отсканировать QR-код. Каждое созданное подключение оплачивается в GREEN-API.
GREEN_PARTNER_TOKEN=

# Сколько номеров можно подключить максимум (защита от лишних расходов)
MAX_NUMBERS=10
